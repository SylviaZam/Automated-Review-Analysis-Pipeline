# Only needed for the model backends. Never commit a real key.

# --backend claude (or log in with the `ant` CLI instead of setting a key)
ANTHROPIC_API_KEY=
# Optional overrides: model id (default claude-opus-5) and effort (low|medium|high)
VOC_CLAUDE_MODEL=
VOC_CLAUDE_EFFORT=

# --backend openai
OPENAI_API_KEY=
VOC_OPENAI_MODEL=
